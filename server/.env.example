# Sunucu yapılandırması
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=galerio
DB_SSL=false
# Bulut veritabanı için: DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

JWT_SECRET=guclu_ve_rastgele_bir_secret_girin
CLIENT_URL=*

# Redis önbellek (Faz 2)
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_TTL=60

# RabbitMQ (Faz 3)
RABBITMQ_URL=amqp://kullanici:sifre@127.0.0.1:5672

# Cloudinary — araç fotoğrafları kalıcı depolama
# https://cloudinary.com → Dashboard → API Keys
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=galerio/vehicles

# E-posta servisi (şifre sıfırlama)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# Admin hesabı (ilk kurulumda otomatik oluşturulur)
ADMIN_EMAIL=admin@sirketiniz.com
ADMIN_PASSWORD=guclu_bir_sifre_girin
ADMIN_NAME=Galeri Admin
