# Yerel geliştirme (node index.js)
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=galerio
DB_SSL=false
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=*

# Redis önbellek (Faz 2) — Docker: redis://localhost:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_TTL=60

# RabbitMQ (Faz 3)
RABBITMQ_URL=amqp://galerio:galerio@127.0.0.1:5672

# İsteğe bağlı e-posta
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# GMAIL_USER=
# GMAIL_PASS=

# Admin seed (node scripts/ensure-admin.js)
ADMIN_EMAIL=admin@galerio.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Galeri Admin
